DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-secret"
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Chatbot con IA real (opcional). Si AI_API_KEY no se define, el chatbot usa
# un motor de reglas local (calcula metas de ahorro sin necesidad de IA).
# Por defecto apunta a la capa gratuita de Google Gemini (API compatible con OpenAI):
# 1. Crea una key gratis en https://aistudio.google.com/apikey
# 2. Pégala abajo en AI_API_KEY
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
